# Staging-only environment for the P6.5D WhatsApp test. Copy to `.env.staging`
# (gitignored) and fill from the Vercel nentra-wa-staging variables.
# Never copy these values into `.env.local` (production) or commit them.
#
# Run with: npx dotenv run -f .env.staging -- <command>
STAGING_DATABASE_URL=postgresql://USER:PASSWORD@ep-floral-sunset-b4qbqg0r.<rest-of-neon-host>/neondb?sslmode=require
WHATSAPP_CONTACT_HMAC_KEY=
WHATSAPP_CONTACT_ENCRYPTION_KEY=
WHATSAPP_ENABLED=false
NENTRA_WORKER_ID=nentra-staging-worker
NENTRA_WORKER_POLL_MS=500
NENTRA_JOB_LEASE_MS=30000
# Owner-authorized test number in E.164, used only by the provision step.
# It is never printed, logged, or committed.
WHATSAPP_TEST_NUMBER=
