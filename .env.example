# Canonical PostgreSQL connection used by the web process, worker, migrations, and seed scripts.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/nentra

# Required for privileged demo mutations. Send this value in
# `x-nentra-operator-secret`; never expose it through NEXT_PUBLIC_*.
NENTRA_DEMO_OPERATOR_SECRET=replace-with-a-long-random-secret

NENTRA_MODE=DEMO_SANDBOX
NENTRA_PUBLIC_ORIGIN=http://localhost:3000
NENTRA_WORKER_ID=local-worker
NENTRA_WORKER_POLL_MS=500
NENTRA_JOB_LEASE_MS=30000
# BASELINE reproduces B0 by stopping after the seeded preferred-quote 503.
# RECOVERED (the default) runs fallback selection, approval, booking, and verification.
NENTRA_RECOVERY_MODE=RECOVERED

# Specialist routing: Investigator and Fulfillment use Groq. Recovery uses DeepSeek.
# Provider keys default to the documented models and official endpoints below.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=10000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_MS=20000

# Backward-compatible OpenAI-compatible fallback when a role's routed provider
# key is absent. Both key and model are required for this fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=8000

# Official neatlogs SDK. No traces are claimed or invented when this is empty.
NEATLOGS_API_KEY=

# WhatsApp Business Platform (Meta Cloud API). Sending stays disabled until
# WHATSAPP_ENABLED=true with a phone number ID, access token, approved
# template and consenting recipient. No secrets or customer numbers here.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_TIMEOUT_MS=
WHATSAPP_MAX_SEND_ATTEMPTS=3
# Inbound webhook verification: Meta app secret signs POST bodies, the verify
# token answers the GET subscription challenge.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Contact privacy: HMAC key for sender lookup, 32-byte encryption key (hex or
# base64) for the stored recipient number. Both required before any send or
# inbound correlation.
WHATSAPP_CONTACT_HMAC_KEY=
WHATSAPP_CONTACT_ENCRYPTION_KEY=

# Provider routing: meta (default) or twilio. WHATSAPP_ENABLED stays false
# unless messaging is explicitly enabled in an isolated test environment.
WHATSAPP_PROVIDER=meta
# Twilio WhatsApp Sandbox (trial). All values stay server-side.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Public HTTPS base URL of this deployment, used for Twilio webhook
# signature validation (no trailing slash). No live sends without it.
TWILIO_PUBLIC_BASE_URL=

# Optional provider test integration, disabled for the backend MVP.
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_BASE_URL=
